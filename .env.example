# ============================================================
# YouTube Trend Analyzer — Environment Variables
# Copy this file to .env and fill in your secrets.
#   cp .env.example .env
# ============================================================

# ---------------------- Proxy Settings -------------------
HTTP_PROXY=socks5://127.0.0.1:8080

# ---------------------- Application ----------------------
APP_NAME=YouTube Trend Analyzer
# RUN_MODE=once              # "once" for single run, "scheduled" for continuous
# POLL_INTERVAL_MINUTES=60   # minutes between scheduled runs (min 5)
# LOG_LEVEL=INFO             # TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------------------- YouTube API ----------------------
# Required. Get yours at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- LLM Provider Settings ---
LLM_PROVIDER=gemini
ACTIVE_LLM_MODEL=gemini-2.5-flash
ACTIVE_LLM_API_KEY=your_gemini_or_gapgpt_api_key_here

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=90

# ---------------------- Telegram Notifier -----------------
# Required. Get yours from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Target chat ID (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# TELEGRAM_PARSE_MODE=HTML
# TELEGRAM_DISABLE_WEB_PREVIEW=true

# ---------------------- Database --------------------------
# DB_PATH=./data/trends.db

# ---------------------- Targets ---------------------------
# Comma-separated topics for RSS search discovery
TARGET_TOPICS=["تراپی نوستالژیک", "موسیقی جاز", "موسیقی مفهومی", "موسیقی تلفیقی"]

# Comma-separated YouTube channel IDs for direct RSS monitoring
# TARGET_CHANNEL_IDS=["UCBJycsmduvYEL83R_U4JriQ"]
TARGET_CHANNEL_IDS=[]

# ---------------------- Scraping --------------------------
# YOUTUBE_RSS_TIMEOUT=30
# YOUTUBE_API_TIMEOUT=15
# YOUTUBE_MAX_RESULTS=50
# YOUTUBE_MAX_COMMENTS=20
# VIDEO_AGE_DAYS_MAX=2
# TOP_N_VIDEOS=5